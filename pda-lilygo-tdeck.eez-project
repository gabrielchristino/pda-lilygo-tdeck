        {
          "objID": "65de8aab-546a-4d6b-e3a5-303b161e5df8",
          "type": "SetVariableActionComponent",
          "left": 1411,
          "top": 144,
          "width": 440,
          "height": 167,
          "customInputs": [
            {
              "objID": "9d70c38e-85b8-42a2-fdc5-a7214830e341",
              "name": "ano",
              "type": "integer"
            },
            {
              "objID": "96571a7b-d7db-4ae7-ba17-876d923f0901",
              "name": "mes",
              "type": "integer"
            }
          ],
          "customOutputs": [],
          "entries": [
            {
              "objID": "aa226694-b79f-4ab4-a661-d7f0daeddd93",
              "variable": "K",
              "value": "(ano % 100)"
            },
            {
              "objID": "cdf14e35-4089-4976-98a2-b2b028a184da",
              "variable": "J",
              "value": "(ano / 100)"
            },
            {
              "objID": "7a85cdf1-a160-492f-fd9c-c3005cacd9a1",
              "variable": "parte_mes",
              "value": "(13 * (mes + 1)) / 5"
            },
            {
              "objID": "e9eb5368-2ffe-4b00-c742-4c2a9309ab68",
              "variable": "parte_K",
              "value": "K / 4"
            },
            {
              "objID": "2a561afa-d093-45bf-cc24-63ad79846780",
              "variable": "parte_J",
              "value": "J / 4"
            },
            {
              "objID": "f7a6dfa0-47b7-4c61-c3f8-25ac314a82ac",
              "variable": "week_day",
              "value": "(1 + parte_mes + K + parte_K + parte_J - 2 * J)"
            }
          ]
        }
      ],
