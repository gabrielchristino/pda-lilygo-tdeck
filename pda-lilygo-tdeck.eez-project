          "customOutputs": [],
          "tests": [
            {
              "objID": "562c5947-410d-4750-ac0c-4c820a68608a",
              "condition": "calc_function == \"divi\"",
              "outputName": "divi",
              "outputValue": "Flow.parseFloat(calc_first_number) / Flow.parseFloat(calc_second_number)"
            },
            {
              "objID": "aea6b11b-2826-4414-8481-e33f404e0035",
              "condition": "calc_function == \"multi\"",
              "outputName": "multi",
              "outputValue": "Flow.parseFloat(calc_first_number) * Flow.parseFloat(calc_second_number)"
            },
            {
              "objID": "94aaba3c-dc6f-4f5b-8286-577836ee4df1",
              "condition": "calc_function == \"plus\"",
              "outputName": "plus",
              "outputValue": "Flow.parseFloat(calc_first_number) + Flow.parseFloat(calc_second_number)"
            },
            {
              "objID": "dc19b14e-1f12-4346-d4c8-e57a61566599",
              "condition": "calc_function == \"minus\"",
              "outputName": "minus",
              "outputValue": "Flow.parseFloat(calc_first_number) - Flow.parseFloat(calc_second_number)"
            }
          ]
        },
