              "variable": "newEvent",
              "value": "[\neventName,\nDate.toString(Date.make(selectedYear,selectedMonth,selectedDay,hoursList[startHour],minutesList[startMinute],0,0)),\nDate.toString(Date.make(selectedYear,selectedMonth,selectedDay,hoursList[endHour],minutesList[endMinute],0,0)),\nselectedYear+\"-\"+selectedMonth+\"-\"+selectedDay\n]"
